+// Keep worksheet records separate from nested chart caches ([MS-XLS] 2.4.21).
+function worksheetRecords(records: ReadonlyArray<BiffRecord>): Array<BiffRecord> {
+  let depth = 0;
+  return records.filter(record => {
+    if (record.type === REC.BOF) depth++;
+    const belongsToSheet = depth === 1;
+    if (record.type === REC.EOF) depth--;
+    return belongsToSheet;
+  });
+}
